{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logix IDE",
  "version": "0.0.0",
  "identifier": "org.openlogix.logix-ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Logix IDE",
        "width": 1100,
        "height": 750,
        "minWidth": 700,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": {
        "upgradeCode": "911DD8BD-9534-48F6-95DF-2C4E3C1E0C20",
        "version": "0.0.0",
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": { "width": 600, "height": 360 },
        "appPosition": { "x": 160, "y": 150 },
        "applicationFolderPosition": { "x": 440, "y": 150 }
      }
    }
  }
}
