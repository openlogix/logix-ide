{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logix",
  "version": "0.1.0",
  "identifier": "io.github.zapta.logix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Logix",
        "width": 1100,
        "height": 750,
        "minWidth": 700,
        "minHeight": 450
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": { "width": 600, "height": 360 },
        "appPosition": { "x": 160, "y": 170 },
        "applicationFolderPosition": { "x": 440, "y": 170 }
      }
    }
  }
}
