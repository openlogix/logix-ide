{
  "name": "logix",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "description": "\"The Arduino experience, for FPGAs\": a simple IDE for FPGAs, powered by Apio",
  "type": "module",
  "appConstants": {
    "apioCliReleaseRepo": "fpgawars/apio",
    "apioCliReleaseTag": "2026-10-22"
  },
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --workspace ui --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test": "vitest run --config ui/vite.config.ts",
    "test:e2e": "playwright test --config ui/playwright.config.ts",
    "docs:screenshots": "playwright test --config ui/playwright.docs.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3.2.7"
  }
}
