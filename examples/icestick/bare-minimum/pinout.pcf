# Constraint file of the bare-minimum example for the iCEstick Eval Kit board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk 21

# LEDs, active high.
set_io leds[0] 99
set_io leds[1] 98
set_io leds[2] 97
set_io leds[3] 96
set_io leds[4] 95
