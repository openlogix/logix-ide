# Constraint file of the bare-minimum example for the Icezum Alhambra board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk 21

# LEDs, active high.
set_io leds[0] 95
set_io leds[1] 96
set_io leds[2] 97
set_io leds[3] 98
set_io leds[4] 99
set_io leds[5] 101
set_io leds[6] 102
set_io leds[7] 104
