// Pins of Sipeed Tang Nano 20k used by main.v.

// sys_clk: 27 MHz clock.
IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;

// uart: the USB serial port.
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33;

// led: LED (active low).
IO_LOC "led" 15;
IO_PORT "led" IO_TYPE=LVCMOS33;
