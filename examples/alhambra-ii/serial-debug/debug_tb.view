{
  "version": 1,
  "rows": [
    {
      "signal": "debug_tb.clk",
      "show_as": "bin",
      "color": 1
    },
    {
      "group": "Serial lines"
    },
    {
      "signal": "debug_tb.uart_rx",
      "show_as": "bin",
      "color": 2
    },
    {
      "signal": "debug_tb.uart_tx",
      "show_as": "bin",
      "color": 2
    },
    {
      "group": "Printing"
    },
    {
      "signal": "debug_tb.print",
      "show_as": "bin",
      "color": 4
    },
    {
      "signal": "debug_tb.value",
      "show_as": "hex",
      "color": 4
    },
    {
      "signal": "debug_tb.dut.printer.busy",
      "show_as": "bin",
      "color": 4
    },
    {
      "group": "Typing"
    },
    {
      "signal": "debug_tb.typed",
      "show_as": "bin",
      "color": 3
    },
    {
      "signal": "debug_tb.typed_value",
      "show_as": "hex",
      "color": 3
    }
  ]
}
