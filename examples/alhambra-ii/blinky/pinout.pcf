# Constraint file of the blinky example for the Alhambra II board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk 49

# LEDs, active high.
set_io leds[0] 45
set_io leds[1] 44
set_io leds[2] 43
set_io leds[3] 42
set_io leds[4] 41
set_io leds[5] 39
set_io leds[6] 38
set_io leds[7] 37
