# Constraint file of the blinky example for the ICENode board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk 35

# LEDs, active low.
# On the FPGA's dedicated RGB LED driver pins.
set_io rgb_led[0] 39
set_io rgb_led[1] 40
set_io rgb_led[2] 41
