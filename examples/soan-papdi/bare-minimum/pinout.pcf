# Constraint file of the bare-minimum example for the Soan-Papdi board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk 35

# LEDs, active high.
set_io leds[0] 31
set_io leds[1] 32
set_io leds[2] 34
set_io leds[3] 36
set_io leds[4] 37
set_io leds[5] 44
set_io leds[6] 45
set_io leds[7] 46
