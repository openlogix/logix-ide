// Constraint file of the blinky example for the Sipeed Tang Primer 20K
// board. It assigns the design's signals to FPGA pins, and lists only
// the pins that this example uses.
//
// An iCEBreaker 7-segment display PMOD on the Lite's top-right PMOD
// connector. Segments are active low.

// Clock (27MHz).
IO_LOC  "sys_clk" H11;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;
CLOCK_LOC "sys_clk" BUFG;

// Segments A to G (PMOD pins 1 to 4 and 7 to 9).
IO_LOC  "segs_n[0]" T6;
IO_LOC  "segs_n[1]" T7;
IO_LOC  "segs_n[2]" T8;
IO_LOC  "segs_n[3]" T9;
IO_LOC  "segs_n[4]" P6;
IO_LOC  "segs_n[5]" R8;
IO_LOC  "segs_n[6]" P8;
IO_PORT "segs_n[0]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[1]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[2]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[3]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[4]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[5]" IO_TYPE=LVCMOS33;
IO_PORT "segs_n[6]" IO_TYPE=LVCMOS33;

// Digit select (PMOD pin 10).
IO_LOC  "digit_sel" P9;
IO_PORT "digit_sel" IO_TYPE=LVCMOS33;
