// Constraint file of the bare-minimum example for the Sipeed Tang Primer 20K Dock board.
// It assigns the design's signals to FPGA pins, and lists only
// the pins that this example uses.

// Clock (27MHz).
IO_LOC  "sys_clk" H11;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;

// LEDs, active level unknown, taken as high.
IO_LOC  "leds[0]" L16;
IO_PORT "leds[0]" IO_TYPE=LVCMOS33;
IO_LOC  "leds[1]" L14;
IO_PORT "leds[1]" IO_TYPE=LVCMOS33;
IO_LOC  "leds[2]" N14;
IO_PORT "leds[2]" IO_TYPE=LVCMOS33;
IO_LOC  "leds[3]" N16;
IO_PORT "leds[3]" IO_TYPE=LVCMOS33;
IO_LOC  "leds[4]" A13;
IO_PORT "leds[4]" IO_TYPE=LVCMOS33;
IO_LOC  "leds[5]" C13;
IO_PORT "leds[5]" IO_TYPE=LVCMOS33;
