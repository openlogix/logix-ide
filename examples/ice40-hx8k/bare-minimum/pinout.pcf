# Constraint file of the bare-minimum example for the iCE40-HX8K Breakout Board board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk J3

# LEDs, active high.
set_io leds[0] C3
set_io leds[1] B3
set_io leds[2] C4
set_io leds[3] C5
set_io leds[4] A1
set_io leds[5] A2
set_io leds[6] B4
set_io leds[7] B5
