# Constraint file of the bare-minimum example for the The Go Board board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (25MHz).
set_io sys_clk 15

# LEDs, active high.
set_io leds[0] 56
set_io leds[1] 57
set_io leds[2] 59
set_io leds[3] 60
