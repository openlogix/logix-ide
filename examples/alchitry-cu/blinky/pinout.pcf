# Constraint file of the blinky example for the Alchitry Cu Development Board board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (100MHz).
set_io sys_clk P7

# LEDs, active high.
set_io leds[0] J11
set_io leds[1] K11
set_io leds[2] K12
set_io leds[3] K14
set_io leds[4] L12
set_io leds[5] L14
set_io leds[6] M12
set_io leds[7] N14
