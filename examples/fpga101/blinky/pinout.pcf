# Constraint file of the blinky example for the FPGA 101 - Workshop Badge board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (12MHz).
set_io sys_clk 35

# RGB LED, active low: [0] red, [1] green, [2] blue.
# On the FPGA's dedicated RGB LED driver pins.
set_io rgb_led[0] 41
set_io rgb_led[1] 39
set_io rgb_led[2] 40
