# Pins of Icesugar Pro used by main.v.

# sys_clk: 25 MHz clock.
LOCATE COMP "sys_clk" SITE "P6";
IOBUF PORT "sys_clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "sys_clk" 25 MHZ;

# uart: the USB serial port.
LOCATE COMP "uart_tx" SITE "B9";
IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33;
LOCATE COMP "uart_rx" SITE "A9";
IOBUF PORT "uart_rx" IO_TYPE=LVCMOS33;

# led: LED (active low).
LOCATE COMP "led" SITE "A11";
IOBUF PORT "led" IO_TYPE=LVCMOS33;
