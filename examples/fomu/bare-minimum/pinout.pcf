# Pins of Fomu used by main.v.

# sys_clk: 48 MHz clock.
set_io sys_clk F4

# rgb_led: RGB LED (active low), on the FPGA's RGB LED driver pads.
set_io rgb_led[0] B5
set_io rgb_led[1] C5
set_io rgb_led[2] A5

# usb_dp: held low (disconnects the board from USB).
set_io usb_dp A1

# usb_dn: held low (disconnects the board from USB).
set_io usb_dn A2

# usb_dp_pu: held low (disconnects the board from USB).
set_io usb_dp_pu A4
