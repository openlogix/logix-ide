# Constraint file of the blinky example for the ULX3S 85K board.
# It assigns the design's signals to FPGA pins, and lists only
# the pins that this example uses.

# Clock (25MHz).
LOCATE COMP "sys_clk" SITE "G2";
IOBUF  PORT "sys_clk" IO_TYPE=LVCMOS33;
FREQUENCY PORT "sys_clk" 25 MHZ;

# LEDs, active high.
LOCATE COMP "leds[0]" SITE "B2";
IOBUF  PORT "leds[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "leds[1]" SITE "C2";
IOBUF  PORT "leds[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "leds[2]" SITE "C1";
IOBUF  PORT "leds[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "leds[3]" SITE "D2";
IOBUF  PORT "leds[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "leds[4]" SITE "D1";
IOBUF  PORT "leds[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "leds[5]" SITE "E2";
IOBUF  PORT "leds[5]" IO_TYPE=LVCMOS33;
LOCATE COMP "leds[6]" SITE "E1";
IOBUF  PORT "leds[6]" IO_TYPE=LVCMOS33;
LOCATE COMP "leds[7]" SITE "H3";
IOBUF  PORT "leds[7]" IO_TYPE=LVCMOS33;

# Held high: wifi_gpio0.
LOCATE COMP "wifi_gpio0" SITE "L2";
IOBUF  PORT "wifi_gpio0" IO_TYPE=LVCMOS33;
