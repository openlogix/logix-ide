// What Logix IDE on config 001 uses on the prod channel (Remote updates, in the
// website repo's CLAUDE.md): the Logix IDE releases assign.jsonc lists under
// prod, and every other channel without a file of its own here (dev, while
// there's no dev-channel.jsonc). Every such Logix IDE reads this file from
// main, so a change here reaches users without a Logix IDE release. Change it
// only by pull request, saying why in a comment; the tests run with what it
// names. It names only stable releases (prod ones), which are never deleted.
{
  "$schema": "https://www.openlogix.org/schemas/logix-remote-config-v1.json",
  // The newest Logix IDE on prod, which Help > Check for Updates tells
  // older Logix IDEs about: the newest release on prod in assign.jsonc. Set
  // it when promoting, in the newest config version's file. No file: the
  // installers differ by platform, and nothing downloads it.
  "latest": {
    "repo": "openlogix/logix-ide",
    "release": "2026-11-21"
  },
  "dependencies": {
    // Logix Engine, which builds, tests and programs the board, and downloads
    // its own FPGA tools and board catalog (its own remote config).
    // Pinned at the first promotion, 2026-11-13.
    // 2026-11-16, the Windows promotion (Milestone 3): Windows, its drivers
    // (list_devices' driver, install_driver, uninstall_driver) and
    // get_engine_info's version tree, which Logix IDE 2026-11-15 goes with.
    // 2026-11-18, the Linux promotion (Milestone 4): Linux, its udev rules
    // (install_driver and uninstall_driver), the Linux session in
    // operating_system, and the shorter log names Logix IDE 2026-11-17 goes
    // with.
    // 2026-11-21, a promotion: the serial tools for the Serial Monitor (bytes
    // as hex, which Logix IDE decodes), a board's resources by type, the
    // driver and udev texts Logix IDE shows, the new remote config files,
    // check_updates' newer_engine, and the waveform viewer in place of
    // GTKWave (Milestone 5: simulate's viewer, open_waveform).
    "logix-engine": {
      "repo": "openlogix/logix-engine",
      "release": "2026-11-21",
      "file": "logix-engine-${PLATFORM}-${YYYYMMDD}.tgz"
    },

    // Logix IDE's examples (File > Examples, and each board's Bare Minimum),
    // packed by this repo's pre-release workflow (scripts/pack-examples.py).
    // Pinned at the first promotion, 2026-11-13.
    // 2026-11-21, a promotion: the serial and serial-debug examples, on the
    // boards with a UART.
    "logix-ide-examples": {
      "repo": "openlogix/logix-ide",
      "release": "2026-11-21",
      "file": "logix-ide-examples-${YYYYMMDD}.tgz"
    }
  }
}
