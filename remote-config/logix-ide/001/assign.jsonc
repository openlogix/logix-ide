// Assigns Logix IDE's releases to channels, for config version 001 (Remote
// updates, in the website repo's CLAUDE.md). A release listed under a channel
// reads that channel's file here, <channel>-channel.jsonc (prod-channel.jsonc
// when it has none); every other release is on dev, the default, and local
// builds always are. Change it only by pull request: adding a release under
// prod promotes it (it must be stable first; then set latest in
// prod-channel.jsonc of the newest config version too).
{
  "$schema": "https://www.openlogix.org/schemas/logix-assign-v1.json",

  // The first promotion, 2026-11-13.
  // 2026-11-16: Windows (Milestone 3), drivers and the new System Info.
  // 2026-11-18: Linux (Milestone 4), with udev rules for boards.
  // 2026-11-21: the Waveforms window in place of GTKWave (Milestone 5), the
  // Serial Monitor and the serial examples, many files (Go to File), auto
  // save and folder watching for AI agents, and Check for Updates telling of
  // a newer Logix IDE.
  // 2026-11-24: the public launch (Milestone 6): the banner telling of a
  // newer Logix IDE, Board Memory and Board Connection, Using an AI Agent,
  // the standard examples rewritten (rgb-fade new), and a deleted project
  // folder no longer blocking Close and Open.
  "prod": ["2026-11-12", "2026-11-15", "2026-11-17", "2026-11-21", "2026-11-24"]
}
